APP_ENV=local
DATABASE_URL=postgresql+psycopg://postgres:replace-me@localhost:5432/motion_capture
MIGRATION_POLICY=warn
REPOSITORY_ADAPTER=postgresql
AUTH_ADAPTER=google
OAUTH_ATTEMPT_CLEANUP_RETENTION_HOURS=24
AUTH_SESSION_CLEANUP_RETENTION_DAYS=30

# Task 62: local normal runtime uses a dedicated private GCS development bucket.
# Tests set STORAGE_ADAPTER=fake explicitly. Production/prod-like reject fake storage.
STORAGE_ADAPTER=gcs
GCS_PROJECT_ID=motion-detection-system-474713
GCS_BUCKET_NAME=replace-with-private-dev-bucket
# Local only. Production should use workload identity instead of a JSON key.
GCS_CREDENTIALS_FILE=C:/Users/replace-me/.config/motion-capture/gcs-dev-service-account.json
STORAGE_UPLOAD_TTL_SECONDS=600
STORAGE_DOWNLOAD_TTL_SECONDS=600
STORAGE_MAX_VIDEO_BYTES=1073741824
STORAGE_MAX_JSON_BYTES=104857600
STORAGE_MAX_THUMBNAIL_BYTES=10485760
RECORD_PROCESSING_TIMEOUT_SECONDS=30
