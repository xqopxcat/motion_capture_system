APP_ENV=local
DATABASE_URL=postgresql+psycopg://motion:change-me@localhost:5432/motion_capture
TEST_DATABASE_URL=postgresql+psycopg://motion_test:change-me@localhost:5432/motion_capture_test
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
MIGRATION_POLICY=warn
REPOSITORY_ADAPTER=postgresql
AUTH_ADAPTER=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_OAUTH_ALLOWED_REDIRECT_URIS=["http://localhost:8000/api/auth/google/callback"]
FRONTEND_ORIGIN=http://localhost:5173
AUTH_ALLOWED_ORIGINS=["http://localhost:5173"]
SESSION_COOKIE_NAME=mocap_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_PATH=/
SESSION_LIFETIME_SECONDS=86400
OAUTH_ATTEMPT_LIFETIME_SECONDS=600
DEV_AUTH_ENABLED=false
DEV_AUTH_ALLOWED_ORIGINS=["http://localhost:5173"]
CSRF_MODE=origin
CSRF_ALLOWED_ORIGINS=["http://localhost:5173"]
